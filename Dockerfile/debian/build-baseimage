#!/bin/bash
set -euo pipefail

# ==========================
# 统一绝对路径
# ==========================
root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
tool_dir="${root_dir}"
tmp_dir="${root_dir}/tmp"
mkdir -p "$tmp_dir"

DH="docker.io"
GHCR="ghcr.io"

# 读取s6-overlay版本号
S6_OVERLAY_VERSION=$(curl -sL https://raw.githubusercontent.com/just-containers/s6-overlay/refs/heads/master/conf/defaults.mk | grep '^VERSION' | awk '{print $3}')
if [ -z "$S6_OVERLAY_VERSION" ]; then
    S6_OVERLAY_VERSION="3.2.3.0"
fi

# 读取基础镜像地址
if [ -f "debian-base.md" ]; then
    BASEIMAGE=$(cat ${root_dir}/debian-base.md | grep BASEIMAGE | cut -d'=' -f2)
else
    echo "Error: debian-base.md file not found"
    exit 1
fi

# 构建参数
timeBuild=$(date +"%Y%m%d%H")
stableVer="baseimage-s6-overlay_v${S6_OVERLAY_VERSION}_${timeBuild}"

# ==========================
# 读取用户仓库配置
# ==========================
user_repo_file="${root_dir}/.user_repo"
if [ ! -f "${user_repo_file}" ]; then
    echo -e "\n❌ 错误：用户仓库配置文件不存在！"
    echo -e "📁 请创建文件： ${user_repo_file}"
    echo -e "✏️ 内容示例：aspnmy/debian-base\n"
    exit 1
fi
USER_REPO_NAME=$(cat "${user_repo_file}" | tr -d '\n' | tr -d ' ')
if [ -z "${USER_REPO_NAME}" ]; then
    echo -e "\n❌ 错误：.user_repo 文件内容为空！\n"
    exit 1
fi

IMGE_NAME="${USER_REPO_NAME}:${stableVer}"
IMAGE_ZSTD_FULL="${IMGE_NAME}-zstd-lts"

# ==========================
# 构建标准镜像
# ==========================
build_s6_baseimage() {
    echo -e "\n=== 构建标准镜像 ==="
    cat <<EOF > "s6_baseimage.Dockerfile"
FROM ${BASEIMAGE}
FROM ${BASEIMAGE} AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    xz-utils \
    curl

RUN mkdir -p /tmp/s6-overlay \
    && curl -fsSL https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz -o /tmp/s6-overlay-noarch.tar.xz \
    && curl -fsSL https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz -o /tmp/s6-overlay-x86_64.tar.xz \
    && tar -C /tmp/s6-overlay -Jxpf /tmp/s6-overlay-noarch.tar.xz \
    && tar -C /tmp/s6-overlay -Jxpf /tmp/s6-overlay-x86_64.tar.xz

FROM ${BASEIMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    && mkdir -p /var/run/sshd \
    && mkdir -p /aspnmy/bin \
    && mkdir -p /aspnmy/wwwroot/ssh_key \
    && chmod 700 /var/run/sshd \
    && chown root:root /var/run/sshd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /tmp/s6-overlay/ /

COPY /app/roottools/build/setRootKey_Cli /aspnmy/bin/
RUN chmod +x /aspnmy/bin/setRootKey_Cli

RUN rm -f /etc/localtime \
    && ln -s /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" | tee /etc/timezone

RUN mkdir -p /root/.ssh \
    && chmod 700 /root/.ssh \
    && mkdir -p /run/sshd \
    && chmod 755 /run/sshd

RUN /aspnmy/bin/setRootKey_Cli superman

RUN mkdir -p /etc/s6-overlay/s6-rc.d/sshd \
    && mkdir -p /etc/s6-overlay/s6-rc.d/sshd/dependencies.d \
    && mkdir -p /etc/s6-overlay/s6-rc.d/sshd/log \
    && mkdir -p /var/log/sshd \
    && touch /etc/s6-overlay/s6-rc.d/user/contents.d/sshd \
    && touch /etc/s6-overlay/s6-rc.d/sshd/dependencies.d/base \
    && echo "longrun" > /etc/s6-overlay/s6-rc.d/sshd/type \
    && printf "#!/bin/sh\n/usr/sbin/sshd -D\n" > /etc/s6-overlay/s6-rc.d/sshd/run \
    && chmod +x /etc/s6-overlay/s6-rc.d/sshd/run \
    && printf "#!/bin/sh\nexec s6-log -b -- n20 s1000000 /var/log/sshd\n" > /etc/s6-overlay/s6-rc.d/sshd/log/run \
    && chmod +x /etc/s6-overlay/s6-rc.d/sshd/log/run

EXPOSE 622
ENTRYPOINT ["/init"]
EOF

    docker build --no-cache -f "s6_baseimage.Dockerfile" -t "${IMGE_NAME}" ..
    rm -rf "s6_baseimage.Dockerfile"
}

# ==========================
# ✅ 集成你的最终版 zstd 压缩
# ==========================
build_oci_zstd_image() {
    SOURCE_IMAGE="$IMGE_NAME"
    ZSTD_IMAGE="$IMAGE_ZSTD_FULL"
    TMP_FILE="$(mktemp -p "$tmp_dir").tar.zst"

    # 检查依赖
    if ! command -v zstd &> /dev/null; then
        echo "安装 zstd..."
        apt update && apt install -y zstd -y
    fi

    echo -e "\n========================================"
    echo "🔹 本地压缩镜像为 zstd"
    echo "🔹 源镜像：$SOURCE_IMAGE"
    echo "🔹 输出镜像：$ZSTD_IMAGE"
    echo -e "========================================"

    # 导出并压缩
    echo "🚀 导出并压缩中..."
    docker save "$SOURCE_IMAGE" | zstd -T0 -15 -f -o "$TMP_FILE"

    # 导入
    echo "✅ 导入压缩镜像..."
    docker load -i "$TMP_FILE"

    # 打标签
    docker tag "$SOURCE_IMAGE" "$ZSTD_IMAGE"

    # 清理
    rm -rf "$tmp_dir"/*

    echo -e "\n🎉 zstd 镜像构建完成！"
    echo "👉 $ZSTD_IMAGE"
}

# ==========================
# 推送所有镜像
# ==========================
push_s6_baseimage() {
    echo -e "\n=== 推送标准镜像 ==="
    docker tag "${IMGE_NAME}" "${DH}/${IMGE_NAME}-lts"
    docker tag "${IMGE_NAME}" "${GHCR}/${IMGE_NAME}-lts"
    docker push "${DH}/${IMGE_NAME}-lts"
    docker push "${GHCR}/${IMGE_NAME}-lts"

    echo -e "\n=== 推送 OCI zstd 压缩镜像 ==="
    docker tag "${IMAGE_ZSTD_FULL}" "${DH}/${IMAGE_ZSTD_FULL}"
    docker tag "${IMAGE_ZSTD_FULL}" "${GHCR}/${IMAGE_ZSTD_FULL}"
    docker push "${DH}/${IMAGE_ZSTD_FULL}"
    docker push "${GHCR}/${IMAGE_ZSTD_FULL}"
    
    echo -e "\n✅ ${DH}/${IMGE_NAME}-lts 全部推送完成！"
    echo -e "\n✅ ${GHCR}/${IMGE_NAME}-lts 全部推送完成！"
    echo -e "\n✅ ${DH}/${IMAGE_ZSTD_FULL} 全部推送完成！"
    echo -e "\n✅ ${GHCR}/${IMAGE_ZSTD_FULL} 全部推送完成！"
}

# ==========================
# 主流程
# ==========================
main() {
    build_s6_baseimage       # 1. 构建标准镜像
    build_oci_zstd_image     # 2. 自动压缩成 zstd
    push_s6_baseimage        # 3. 推送两个版本
}

main