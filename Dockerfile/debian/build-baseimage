#!/bin/bash
set -euo pipefail

# ==========================
# debian_ssh.s6-overlay build script
# 多阶段构建 + buildx 多架构支持 (amd64/arm64)
# ==========================
root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
tmp_dir="${root_dir}/tmp"
mkdir -p "$tmp_dir"

S6_VER="${S6_OVERLAY_VERSION:-3.2.3.0}"
DEVROM="devrom.org"

# 读取基础镜像
if [ -f "${root_dir}/debian-base.md" ]; then
    BASEIMAGE=$(grep BASEIMAGE "${root_dir}/debian-base.md" | cut -d= -f2)
else
    echo "Error: debian-base.md not found"
    exit 1
fi

# 读取用户仓库
USER_REPO=$(cat "${root_dir}/.user_repo" | tr -d '\n ')
[ -z "$USER_REPO" ] && { echo "Error: .user_repo empty"; exit 1; }

timeBuild=$(date +"%Y%m%d%H")
stableVer="baseimage-s6-overlay_v${S6_VER}_${timeBuild}"
IMGE_NAME="${USER_REPO}:${stableVer}"
IMAGE_ZSTD="${IMGE_NAME}-zstd-lts"

# 多架构平台列表
PLATFORMS=("linux/amd64" "linux/arm64")

# ==========================
# 检测 buildx 可用性
# ==========================
use_buildx() {
    docker buildx version >/dev/null 2>&1 && return 0 || return 1
}

# ==========================
# 构建 Dockerfile 模板
# ==========================
gen_dockerfile() {
    local dockerfile="${tmp_dir}/Dockerfile"
    cat > "$dockerfile" << 'DOCKERFILE'
# syntax=docker/dockerfile:1
FROM ${BASEIMAGE} AS s6-downloader
RUN apt-get update && apt-get install -y --no-install-recommends xz-utils curl ca-certificates \
    && mkdir -p /tmp/s6 \
    && curl -fsSL https://github.com/just-containers/s6-overlay/releases/download/v${S6_VER}/s6-overlay-noarch.tar.xz -o /tmp/s6-noarch.tar.xz \
    && curl -fsSL https://github.com/just-containers/s6-overlay/releases/download/v${S6_VER}/s6-overlay-$(uname -m | sed 's/aarch64/aarch64/;s/x86_64/x86_64/').tar.xz -o /tmp/s6-arch.tar.xz \
    && tar -C /tmp/s6 -Jxpf /tmp/s6-noarch.tar.xz \
    && tar -C /tmp/s6 -Jxpf /tmp/s6-arch.tar.xz \
    && rm -f /tmp/s6-noarch.tar.xz /tmp/s6-arch.tar.xz

# Runtime stage: minimal Debian + SSH + s6-overlay
FROM ${BASEIMAGE}
ENV DEBIAN_FRONTEND=noninteractive

# Install only openssh-server netcat-openbsd python3, clean up
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-server netcat-openbsd python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Fix container warnings early
COPY app/roottools/fix-warnings.sh /aspnmy/bin/
RUN bash /aspnmy/bin/fix-warnings.sh

# Copy s6-overlay
COPY --from=s6-downloader /tmp/s6/ /

# Copy tools
COPY app/roottools/setRootKey_Cli.sh.s6 /aspnmy/bin/
COPY app/roottools/mini-key-server.sh /aspnmy/bin/
RUN chmod +x /aspnmy/bin/setRootKey_Cli.sh.s6
RUN chmod +x /aspnmy/bin/mini-key-server.sh

# Timezone
RUN rm -f /etc/localtime \
    && ln -s /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

# SSH directories
RUN mkdir -p /root/.ssh /run/sshd /var/run/sshd /aspnmy/bin /aspnmy/wwwroot/ssh_key \
    && chmod 700 /root/.ssh /var/run/sshd \
    && chmod 755 /run/sshd

# Run SSH key setup
RUN bash /aspnmy/bin/setRootKey_Cli.sh.s6 superman

# Configure s6-overlay for sshd
RUN mkdir -p /etc/s6-overlay/s6-rc.d/sshd/dependencies.d /etc/s6-overlay/s6-rc.d/sshd/log /var/log/sshd \
    && touch /etc/s6-overlay/s6-rc.d/user/contents.d/sshd \
    && touch /etc/s6-overlay/s6-rc.d/sshd/dependencies.d/base \
    && echo "longrun" > /etc/s6-overlay/s6-rc.d/sshd/type \
    && printf '#!/bin/sh\n/usr/sbin/sshd -D\n' > /etc/s6-overlay/s6-rc.d/sshd/run \
    && chmod +x /etc/s6-overlay/s6-rc.d/sshd/run \
    && printf '#!/bin/sh\nexec s6-log -b -- n20 s1000000 /var/log/sshd\n' > /etc/s6-overlay/s6-rc.d/sshd/log/run \
    && chmod +x /etc/s6-overlay/s6-rc.d/sshd/log/run

HEALTHCHECK --interval=30s --timeout=5s CMD pgrep sshd || exit 1
EXPOSE 25
EXPOSE 8880
EXPOSE 622
ENTRYPOINT ["/init"]
DOCKERFILE

    export BASEIMAGE S6_VER
    envsubst < "$dockerfile" > "${dockerfile}.rendered"
    mv "${dockerfile}.rendered" "$dockerfile"
    echo "$dockerfile"
}

# ==========================
# 构建镜像
# ==========================
build_image() {
    local dockerfile
    dockerfile=$(gen_dockerfile)

    if use_buildx; then
        echo "=== Buildx multi-arch (amd64 + arm64) ==="

        # 确保 buildx builder 存在
        local builder="s6-multiarch-builder"
        if ! docker buildx inspect "$builder" >/dev/null 2>&1; then
            docker buildx create --name "$builder" --use --bootstrap
        else
            docker buildx use "$builder"
        fi

        local arch_tags=()
        for platform in "${PLATFORMS[@]}"; do
            local arch="${platform#linux/}"
            local arch_tag="${IMGE_NAME}-${arch}"

            echo "=== Building ${platform} ==="
            docker buildx build --platform "$platform" \
                --tag "${arch_tag}" \
                --load \
                -f "$dockerfile" ..

            arch_tags+=("${arch_tag}")
        done

        # 创建多架构 manifest 列表
        echo "=== Creating multi-arch manifest: ${IMGE_NAME} ==="
        docker manifest create "${IMGE_NAME}" "${arch_tags[@]}"
        echo "Multi-arch manifest created: ${IMGE_NAME}"

        # 标记为多架构构建
        touch "${tmp_dir}/.is_multiarch"
    else
        echo "=== Legacy single-arch build ==="
        docker build --no-cache -f "$dockerfile" -t "${IMGE_NAME}" ..
        rm -f "${tmp_dir}/.is_multiarch"
    fi

    rm -f "$dockerfile"
}

# ==========================
# zstd 压缩
# ==========================
package_zstd() {
    if [ -f "${tmp_dir}/.is_multiarch" ]; then
        echo "=== Zstd multi-arch packaging ==="
        local arch_tags=()
        for platform in "${PLATFORMS[@]}"; do
            local arch="${platform#linux/}"
            local arch_tag="${IMGE_NAME}-${arch}"

            local tar_file="${tmp_dir}/img-${arch}.tar"
            docker save "${arch_tag}" -o "$tar_file"
            zstd --fast=1 --rm "$tar_file"
            docker load -i "${tar_file}.zst"
            rm -f "${tmp_dir}/img-${arch}.tar.zst"

            arch_tags+=("${arch_tag}")
        done

        # 重建 manifest（load 后可能丢失）
        docker manifest create "${IMGE_NAME}" "${arch_tags[@]}" 2>/dev/null || true
    else
        echo "=== Zstd single-arch packaging ==="
        local tar_file="${tmp_dir}/img.tar"
        docker save "${IMGE_NAME}" -o "$tar_file"
        zstd --fast=1 --rm "$tar_file"
        docker load -i "${tar_file}.zst"
        docker tag "${IMGE_NAME}" "${IMAGE_ZSTD}"
        rm -f "${tmp_dir}/img.tar.zst"
    fi
}

# ==========================
# 推送 devrom.org
# ==========================
push_devrom() {
    local ver_tag="${stableVer#baseimage-s6-overlay_v}"
    echo "=== Push to devrom.org ==="

    if [ -f "${tmp_dir}/.is_multiarch" ]; then
        # 多架构推送：逐架构 push + manifest push
        local reg_tags=()
        for platform in "${PLATFORMS[@]}"; do
            local arch="${platform#linux/}"
            local arch_tag="${IMGE_NAME}-${arch}"
            local reg_tag="${DEVROM}/aspnmy/debian_ssh_s6-overlay_baseimage:${ver_tag}-${arch}"

            docker tag "${arch_tag}" "${reg_tag}"
            docker push "${reg_tag}"
            reg_tags+=("${reg_tag}")
        done

        # 创建并推送多架构 manifest
        local manifest_tag="${DEVROM}/aspnmy/debian_ssh_s6-overlay_baseimage:${ver_tag}"
        docker manifest create "${manifest_tag}" "${reg_tags[@]}"
        docker manifest push "${manifest_tag}"

        # zstd manifest
        local manifest_zstd="${DEVROM}/aspnmy/debian_ssh_s6-overlay_baseimage:${ver_tag}-zstd"
        docker manifest create "${manifest_zstd}" "${reg_tags[@]}"
        docker manifest push "${manifest_zstd}"
    else
        # 单架构推送（保持兼容）
        docker tag "${IMGE_NAME}" "${DEVROM}/aspnmy/debian_ssh_s6-overlay_baseimage:${ver_tag}"
        docker push "${DEVROM}/aspnmy/debian_ssh_s6-overlay_baseimage:${ver_tag}"
        docker tag "${IMAGE_ZSTD}" "${DEVROM}/aspnmy/debian_ssh_s6-overlay_baseimage:${ver_tag}-zstd"
        docker push "${DEVROM}/aspnmy/debian_ssh_s6-overlay_baseimage:${ver_tag}-zstd"
    fi
}

# ==========================
# 清理
# ==========================
cleanup() {
    rm -rf "${tmp_dir}"
}

# ==========================
# main
# ==========================
main() {
    trap cleanup EXIT
    build_image
    package_zstd
    push_devrom
    echo "Done: ${DEVROM}/aspnmy/debian_ssh_s6-overlay_baseimage:${stableVer#baseimage-s6-overlay_v}"
}

main
