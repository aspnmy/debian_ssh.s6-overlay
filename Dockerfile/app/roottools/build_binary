#!/bin/bash
set -euo pipefail

SCRIPT_PATH="$(dirname "$0")/setRootKey_Cli.sh.s6"
OUTPUT_PATH="$(dirname "$0")/build"
mkdir -p $OUTPUT_PATH
OUTPUT_BIN="$OUTPUT_PATH/setRootKey_Cli"


# 检查源文件
if [ ! -f "$SCRIPT_PATH" ]; then
    echo "错误：文件不存在 $SCRIPT_PATH"
    exit 1
fi

# 安装依赖
echo "=== 安装编译工具 ==="
apt update
apt install -y shc build-essential file

# 编译：使用 shc 官方标准静态编译（完美支持参数）
echo "=== 编译中 ==="
shc -r -f "$SCRIPT_PATH" -o "$OUTPUT_BIN"

chmod +x "$OUTPUT_BIN"

echo -e "\n=== 编译完成 ==="
ls -lh "$OUTPUT_BIN"

echo -e "\n=== 测试运行（验证参数是否正常）==="
$OUTPUT_BIN superman

echo -e "\n✅ 编译成功！参数正常传递！"