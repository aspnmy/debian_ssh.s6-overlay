HOSTSEOF
}

# --- 新增：获取下一个可用的 agent 编号 ---
get_next_agent_num() {
    local base_user="agentuser"
    local num=1
    while id "$base_user$num" &>/dev/null; do
        ((num++))
    done
    echo $num
}

# --- 新增：Agent 用户密钥重置函数 (带编号) ---
reset_sshd_agentkey(){
    local BASE_AGENT_USER="agentuser"
    local AGENT_NUM=$(get_next_agent_num)
    local AGENT_USER="${BASE_AGENT_USER}${AGENT_NUM}"
    local AGENT_EMAIL="${AGENT_USER}@local"
    local AGENT_GROUP="agentgroup"
    local AGENT_HOME="/home/$AGENT_USER"
    # 修改：公钥文件放在预设的目录下
    local AGENT_AUTHORIZED_KEYS_FILE="$SSHKEY_AGENTUSER_DIR/authorized_keys_${AGENT_USER}.pub"
    local AGENT_PRIVATE_KEY_PATH="$AGENT_HOME/.ssh/authorized_keys"
    local AGENT_PUBLIC_KEY_PATH="$AGENT_PRIVATE_KEY_PATH.pub"

    echo "🚀 正在为 Agent 用户 ($AGENT_USER) 生成密钥对..."

    # 1. 创建用户组 (如果不存在)
    if ! getent group "$AGENT_GROUP" > /dev/null; then
        echo "📂 创建用户组: $AGENT_GROUP"
        groupadd "$AGENT_GROUP"
    else
        echo "ℹ️  用户组 $AGENT_GROUP 已存在"
    fi

    # 2. 创建用户 (使用带编号的用户名)
    if ! id "$AGENT_USER" &>/dev/null; then
        echo "👤 创建用户: $AGENT_USER"
        useradd -m -g "$AGENT_GROUP" -s /bin/bash "$AGENT_USER"
        # 赋予 sudo 权限 (根据系统类型)
        if [ -f /etc/debian_version ]; then
            usermod -aG sudo "$AGENT_USER"
        else
            usermod -aG wheel "$AGENT_USER"
        fi
    else
        echo "❌ 错误: 用户 $AGENT_USER 已存在，但脚本逻辑有误，应已被跳过。退出。"
        exit 1
    fi

    # 3. 创建用户 .ssh 目录
    mkdir -p "$AGENT_HOME/.ssh"
    chown "$AGENT_USER:$AGENT_GROUP" "$AGENT_HOME/.ssh"
    chmod 700 "$AGENT_HOME/.ssh"

    # 4. 生成 Agent 密钥对
    # 清理旧密钥
    rm -f "$AGENT_PRIVATE_KEY_PATH" "$AGENT_PUBLIC_KEY_PATH"
    
    echo "🔐 生成 Agent 用户 SSH 密钥对..."
    su - "$AGENT_USER" -c "ssh-keygen -t rsa -b 4096 -m PEM -f '$AGENT_PRIVATE_KEY_PATH' -N '' -C '$AGENT_EMAIL'" > /dev/null
    
    # 设置正确的权限
    chown "$AGENT_USER:$AGENT_GROUP" "$AGENT_PUBLIC_KEY_PATH"
    chmod 600 "$AGENT_PUBLIC_KEY_PATH"

    # 5. 将 Agent 的公钥写入预设的可靠目录
    # 确保目录存在（尽管 check_and_create_dir 已创建，但这里作为额外保障）
    if [ ! -d "$SSHKEY_AGENTUSER_DIR" ]; then
        echo "❌ 错误: 预设的 agent 公钥目录 $SSHKEY_AGENTUSER_DIR 不存在！"
        exit 1
    fi
    cp "$AGENT_PUBLIC_KEY_PATH" "$AGENT_AUTHORIZED_KEYS_FILE"
    chmod 600 "$AGENT_AUTHORIZED_KEYS_FILE"
    chown root:root "$AGENT_AUTHORIZED_KEYS_FILE"

    # 6. 更新 sshd_config 以包含新的 agent 用户路径 (使用通配符，无需修改)
    # 检查配置是否包含通配符路径
    if ! grep -q "/etc/ssh/authorized_keys_agentuser/\*\.pub" "$SSHD_CONFIG_DIR"; then
        echo "⚠️  配置文件可能未包含 agentuser 通配符路径，正在尝试修复..."
        backup_sshd_config
        sed -i.bak 's/^\(AuthorizedKeysFile\s\+\)/#\1/' "$SSHD_CONFIG_DIR"
        cat >> "$SSHD_CONFIG_DIR" <<EOF
# --- Added by setRootKey_Cli script for agent $AGENT_USER ---
# IMPORTANT: /etc/ssh/authorized_keys_superman.pub is static, never remove!
# IMPORTANT: /etc/ssh/authorized_keys_humanuser/*.pub is for human users
# IMPORTANT: /etc/ssh/authorized_keys_agentuser/*.pub is for agent users
AuthorizedKeysFile .ssh/authorized_keys /etc/ssh/authorized_keys_superman.pub /etc/ssh/authorized_keys_humanuser/*.pub /etc/ssh/authorized_keys_agentuser/*.pub
# -------------------------------------------------------------
EOF
        chmod 600 "$SSHD_CONFIG_DIR"
        verify_sshd_config
        echo "✅ SSH 配置文件已更新以包含 agentuser 通配符路径。"
    else
        echo "✅ SSH 配置文件已包含 agentuser 通配符路径。"
    fi

    # 7. 为该特定用户配置 sudo 免密白名单
    local SUDOERS_AGENT_FILE="/etc/sudoers.d/${AGENT_USER}"
    cat > "$SUDOERS_AGENT_FILE" <<EOF
# 允许 $AGENT_USER 免密执行常用管理命令
$AGENT_USER ALL=(ALL) NOPASSWD: /usr/bin/systemctl, /usr/bin/apt-get, /usr/bin/apt,/usr/bin/aptitude,/usr/bin/yum, /usr/bin/dnf, /bin/mount, /bin/umount
EOF
    chmod 440 "$SUDOERS_AGENT_FILE"
    echo "✅ 已为 $AGENT_USER 配置 sudo 免密规则 (仅限常用管理命令)"

    # 8. 将私钥移动到下载目录 (使用带编号的用户名标识)
    local DL_SSHKEY_AGENT_FILES="$DL_SSHKEY_DIR/$(get_Time)_${AGENT_USER}"
    mv "$AGENT_PRIVATE_KEY_PATH" "$DL_SSHKEY_AGENT_FILES"
    echo "🔑 Agent 用户 ($AGENT_USER) 的私钥已生成并移至下载目录: $DL_SSHKEY_AGENT_FILES"
    echo "📋 Agent 公钥已写入: $AGENT_AUTHORIZED_KEYS_FILE"

    echo "✅ Agent 用户 ($AGENT_USER) 密钥重置完成！请从 $DL_SSHKEY_AGENT_FILES 下载私钥。"
    echo "   ⚠️  警告: 请确保测试 Agent 用户登录和 sudo 权限正常后再断开当前会话！"
    echo ""
    echo "⚠️  请手动运行 'setRootKey_Cli sshd' 来重启 SSH 服务使更改生效。"
}


# 主函数 使用参数直接执行业务逻辑
main() {
    # 确保在任何模式执行前，sshd_config 都是正确的
    initialize_sshd_config

    case "$1" in
        "superman")
            reset_sshd_superman
            ;;
        "usrkey")
            reset_sshd_usrkey
            ;;
        "sshd")
            restart_sshd
            ;;
        "set_hosts")
            set_hosts
            ;;
        # --- 替换：webhook 模式 ---
        "webhook")
            send_keys_by_webhook
            ;;
        # --- 废弃：mailto 模式 ---
        "mailto")
            echo "❌ 错误: 'mailto' 模式已弃用。请使用 'webhook' 模式。"
            echo "   请设置 WEBHOOK_URL 环境变量并运行: $0 webhook"
            exit 1
            ;;
        # --- 新增：agent 模式 ---
        "agent")
            reset_sshd_agentkey
            ;;
        *)
            echo "无效的选择。请使用以下格式运行脚本："
            echo "setRootKey_Cli superman"
            echo "setRootKey_Cli usrkey"
            echo "setRootKey_Cli sshd"
            echo "setRootKey_Cli set_hosts"
            # --- 替换：帮助信息 ---
            echo "setRootKey_Cli webhook  # 通过 Webhook 发送下载目录中的私钥文件 (需要 WEBHOOK_URL 环境变量)"
            # --- 废弃：帮助信息 ---
            # echo "setRootKey_Cli mailto"
            # --- 新增：帮助信息 ---
            echo "setRootKey_Cli agent  # 创建 agentuser-N 并生成其专用密钥对"
            echo ""
            echo "环境变量：SSHKEY_EMAIL=user@example.com 可跳过交互输入"
            echo "环境变量：WEBHOOK_URL='your_webhook_url' 用于 webhook 模式"
            exit 1
            ;;
    esac
}

# 调用主函数
main "$@"
