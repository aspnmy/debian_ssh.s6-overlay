#!/bin/bash

# --- 配置 ---
SH_URL="https://raw.githubusercontent.com/aspnmy/debian_ssh.s6-overlay/refs/heads/baseimage/Dockerfile/app/roottools/setRootKey_Cli.sh.s6"
SH_CN_URL="https://git.t2be.cn/aspnmy/debian_ssh.s6-overlay/raw/branch/baseimage/Dockerfile/app/roottools/setRootKey_Cli.sh.s6"
SCRIPT_NAME="setRootKey_Cli.sh.s6"
AGENT_KEYS_DIR="/etc/ssh/authorized_keys_agentuser"
AGENT_GROUP="agentgroup"

# --- 基础日志函数 ---
log_info() { echo "[INFO] $1"; }
log_error() { echo "[ERROR] $1"; }
log_warn() { echo "[WARN] $1"; }

# --- 获取 Agent 用户数组（公共辅助函数）---
get_agent_users_array() {
    local AGENT_GROUP_ID
    AGENT_GROUP_ID=$(getent group "$AGENT_GROUP" | cut -d: -f3)
    
    if [ -z "$AGENT_GROUP_ID" ]; then
        return 1
    fi

    AGENT_USERS_ARR=()
    while IFS= read -r user; do
        [ -n "$user" ] && AGENT_USERS_ARR+=("$user")
    done < <(awk -F: -v gid="$AGENT_GROUP_ID" '$4 == gid { print $1 }' /etc/passwd)
    
    [ ${#AGENT_USERS_ARR[@]} -eq 0 ] && return 1
    return 0
}

# --- 核心管理函数：支持单个/批量删除 Agent 用户 ---
manage_agent_users() {
    log_info "正在检查 Agent 用户..."
    
    if ! get_agent_users_array; then
        log_error "❌ 用户组 '$AGENT_GROUP' 不存在或没有成员。请先运行选项 3。"
        show_menu
        return
    fi

    # 打印列表
    echo ""
    echo "📊 当前 Agent 用户列表："
    local count=0
    for user in "${AGENT_USERS_ARR[@]}"; do
        ((count++))
        echo "  [$count] $user"
    done
    echo "📊 总共找到 $count 个 Agent 用户。"
    echo ""
    
    # ✅ 支持空格或逗号分隔输入多个用户名
    read -p "⚠️  请输入要删除的用户名 (多个用空格/逗号分隔，回车取消): " target_input
    
    if [ -z "$target_input" ]; then
        log_info "已取消操作。"
        show_menu
        return
    fi

    # 统一分隔符并解析为数组
    local normalized_input="${target_input//,/ }"
    local target_arr=()
    read -ra target_arr <<< "$normalized_input"

    # 校验输入合法性(防误删非Agent用户)
    local valid_users=()
    local invalid_users=()
    for u in "${target_arr[@]}"; do
        u=$(echo "$u" | xargs) # 去除首尾空白
        [ -z "$u" ] && continue
        
        local found=0
        for au in "${AGENT_USERS_ARR[@]}"; do
            [ "$au" = "$u" ] && { found=1; break; }
        done
        
        if [ "$found" -eq 1 ]; then
            valid_users+=("$u")
        else
            invalid_users+=("$u")
        fi
    done

    if [ ${#invalid_users[@]} -gt 0 ]; then
        log_error "❌ 以下用户无效或不属于 $AGENT_GROUP，已自动跳过:"
        printf '     %s\n' "${invalid_users[@]}"
    fi

    if [ ${#valid_users[@]} -eq 0 ]; then
        log_error "❌ 没有有效的 Agent 用户可供删除。"
        show_menu
        return
    fi

    # 二次确认
    echo ""
    log_info "即将删除以下 ${#valid_users[@]} 个用户及其关联配置:"
    printf '     %s\n' "${valid_users[@]}"
    read -p "❗ 确认执行删除？(y/N): " confirm
    
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        log_info "已取消删除。"
        show_menu
        return
    fi

    # 执行批量清理
    local success_count=0
    for target_user in "${valid_users[@]}"; do
        echo "----------------------------------------"
        log_info "🗑️  正在清理: $target_user"
        
        # 1. 删除系统用户及家目录
        if userdel -r "$target_user" 2>/dev/null; then
            log_info "   ✅ 系统用户及家目录已删除"
        else
            log_error "   ❌ 删除系统用户失败 (可能有进程占用)"
        fi

        # 2. 删除 SSH 公钥文件
        local pub_key_file="$AGENT_KEYS_DIR/authorized_keys_${target_user}.pub"
        if [ -f "$pub_key_file" ]; then
            rm -f "$pub_key_file"
            log_info "   ✅ 公钥文件已删除: $(basename "$pub_key_file")"
        fi

        # 3. 删除 sudoers 提权配置
        local sudoers_file="/etc/sudoers.d/${target_user}"
        if [ -f "$sudoers_file" ]; then
            rm -f "$sudoers_file"
            log_info "   ✅ Sudoers 配置已删除"
        fi
        
        ((success_count++))
    done

    echo "========================================"
    log_info "✅ 批量清理完成！成功处理 $success_count 个用户。"
    log_info "⚠️  提醒: 请手动编辑 /etc/ssh/sshd_config 移除已删用户的 AuthorizedKeysFile 路径，"
    log_info "         然后运行 ./$SCRIPT_NAME sshd 重启 SSH 服务使配置生效。"
    
    show_menu
}

# --- 核心管理函数：管理 Agent 用户的免密服务 (sudoers) ---
manage_agent_services() {
    log_info "正在加载 Agent 用户列表..."
    
    if ! get_agent_users_array; then
        log_error "❌ 用户组 '$AGENT_GROUP' 不存在或没有成员。请先运行选项 3。"
        show_menu
        return
    fi

    # 打印用户列表供选择
    echo ""
    echo "📊 请选择要操作的 Agent 用户："
    for i in "${!AGENT_USERS_ARR[@]}"; do
        echo "  [$((i+1))] ${AGENT_USERS_ARR[$i]}"
    done
    echo "  [0] 返回主菜单"
    
    read -p "请输入编号: " user_choice
    if [[ "$user_choice" == "0" ]]; then show_menu; return; fi
    
    if ! [[ "$user_choice" =~ ^[0-9]+$ ]] || [ "$user_choice" -lt 1 ] || [ "$user_choice" -gt ${#AGENT_USERS_ARR[@]} ]; then
        log_error "❌ 无效编号"
        manage_agent_services
        return
    fi
    
    local target_user="${AGENT_USERS_ARR[$((user_choice-1))]}"
    local sudoers_file="/etc/sudoers.d/${target_user}"
    
    # 显示当前已有的免密服务
    echo ""
    log_info "🔑 用户 [$target_user] 当前的免密服务配置："
    if [ -f "$sudoers_file" ]; then
        local rules
        rules=$(grep -E "^${target_user}[[:space:]]+ALL=" "$sudoers_file" 2>/dev/null | sed 's/.*NOPASSWD:[[:space:]]*//' )
        if [ -n "$rules" ]; then
            echo "$rules" | while IFS= read -r line; do
                echo "  ✅ $line"
            done
        else
            echo "  (无有效 NOPASSWD 配置)"
        fi
    else
        echo "  (配置文件不存在)"
    fi
    echo ""
    
    # 选择操作类型
    echo "  [1] ➕ 新增免密服务"
    echo "  [2] ➖ 删除免密服务"
    echo "  [0] ↩️  返回上一级"
    read -p "请选择操作: " action_choice
    
    case $action_choice in
        1) add_agent_service "$target_user" "$sudoers_file" ;;
        2) remove_agent_service "$target_user" "$sudoers_file" ;;
        0) manage_agent_services ;;
        *) log_error "❌ 无效操作"; manage_agent_services ;;
    esac
}

# 子功能：新增免密服务
add_agent_service() {
    local target_user="$1"
    local sudoers_file="$2"
    
    read -p "请输入服务名称或命令 (如 nginx, docker, /usr/bin/systemctl): " service_name
    [ -z "$service_name" ] && { log_error "❌ 输入为空"; manage_agent_services; return; }
    
    # 自动查询程序绝对路径
    local bin_path
    if [[ "$service_name" == /* ]]; then
        bin_path="$service_name"  # 用户已输入绝对路径
    else
        bin_path=$(command -v "$service_name" 2>/dev/null)
    fi
    
    if [ -z "$bin_path" ] || [ ! -x "$bin_path" ]; then
        log_error "❌ 无法找到可执行程序: '$service_name'"
        log_error "   请确认程序已安装，或直接输入绝对路径"
        read -p "按回车继续..." _
        manage_agent_services
        return
    fi
    
    log_info "🔍 已定位程序路径: $bin_path"
    
    # 检查是否已存在相同配置
    if [ -f "$sudoers_file" ] && grep -qF "$bin_path" "$sudoers_file"; then
        log_warn "⚠️  该服务的免密配置已存在，跳过添加"
        read -p "按回车继续..." _
        manage_agent_services
        return
    fi
    
    # 写入临时文件并进行 visudo 语法校验（防止写坏 sudoers）
    local tmp_sudoers
    tmp_sudoers=$(mktemp)
    [ -f "$sudoers_file" ] && cp "$sudoers_file" "$tmp_sudoers"
    
    local rule="${target_user} ALL=(ALL) NOPASSWD: ${bin_path}"
    echo "$rule" >> "$tmp_sudoers"
    
    if ! visudo -cf "$tmp_sudoers" > /dev/null 2>&1; then
        log_error "❌ sudoers 语法校验失败，放弃写入"
        rm -f "$tmp_sudoers"
        read -p "按回车继续..." _
        manage_agent_services
        return
    fi
    
    mv "$tmp_sudoers" "$sudoers_file"
    chmod 440 "$sudoers_file"
    chown root:root "$sudoers_file"
    
    log_info "✅ 已成功添加免密服务: $bin_path"
    read -p "按回车继续..." _
    manage_agent_services
}

# 子功能：删除免密服务
remove_agent_service() {
    local target_user="$1"
    local sudoers_file="$2"
    
    if [ ! -f "$sudoers_file" ]; then
        log_warn "⚠️  该用户暂无 sudoers 配置文件"
        read -p "按回车继续..." _
        manage_agent_services
        return
    fi
    
    # 读取所有 NOPASSWD 规则
    local rules=()
    while IFS= read -r line; do
        [ -n "$line" ] && rules+=("$line")
    done < <(grep -E "^${target_user}[[:space:]]+ALL=.*NOPASSWD:" "$sudoers_file" 2>/dev/null)
    
    if [ ${#rules[@]} -eq 0 ]; then
        log_warn "⚠️  该用户暂无 NOPASSWD 免密规则"
        read -p "按回车继续..." _
        manage_agent_services
        return
    fi
    
    echo ""
    echo "📋 当前免密服务列表："
    for i in "${!rules[@]}"; do
        local cmd
        cmd=$(echo "${rules[$i]}" | sed 's/.*NOPASSWD:[[:space:]]*//')
        echo "  [$((i+1))] $cmd"
    done
    echo "  [0] ↩️  取消"
    
    read -p "请输入要删除的编号: " del_choice
    if [[ "$del_choice" == "0" ]]; then manage_agent_services; return; fi
    
    if ! [[ "$del_choice" =~ ^[0-9]+$ ]] || [ "$del_choice" -lt 1 ] || [ "$del_choice" -gt ${#rules[@]} ]; then
        log_error "❌ 无效编号"
        read -p "按回车继续..." _
        manage_agent_services
        return
    fi
    
    local target_rule="${rules[$((del_choice-1))]}"
    local escaped_rule
    escaped_rule=$(printf '%s\n' "$target_rule" | sed 's/[\/&]/\\&/g')
    
    # 从文件中精确移除该行
    local tmp_sudoers
    tmp_sudoers=$(mktemp)
    grep -vxF "$target_rule" "$sudoers_file" > "$tmp_sudoers"
    
    # 如果移除后文件为空或只剩注释，直接删除配置文件
    local remaining_rules
    remaining_rules=$(grep -cE "^${target_user}[[:space:]]+ALL=" "$tmp_sudoers" 2>/dev/null)
    
    if [ "$remaining_rules" -eq 0 ]; then
        rm -f "$sudoers_file" "$tmp_sudoers"
        log_info "✅ 已删除所有免密规则，sudoers 配置文件已移除"
    else
        mv "$tmp_sudoers" "$sudoers_file"
        chmod 440 "$sudoers_file"
        log_info "✅ 已删除免密服务: $(echo "$target_rule" | sed 's/.*NOPASSWD:[[:space:]]*//')"
    fi
    
    read -p "按回车继续..." _
    manage_agent_services
}

# --- 菜单与其他辅助函数 ---
show_menu() {
    echo ""
    echo "==========================================="
    echo "           Init Script Menu              "
    echo "==========================================="
    echo "1. 更新配置脚本-github ($SCRIPT_NAME)"
    echo "2. 更新配置脚本-国内 ($SCRIPT_NAME)"
    echo "3. 设置 Agent 用户组 (创建组/目录/修复文件权限)"
    echo "4. 查看并管理 Agent 用户 (支持批量删除)"
    echo "5. 管理 Agent 免密服务 (新增/删除 sudoers)"
    echo "6. 运行原始初始化流程 (下载/设置脚本)"
    echo "0. 退出"
    echo "==========================================="
    read -p "请选择操作 (0-6): " choice

    case $choice in
        1) update_script ;;
        2) update_script_cn ;;
        3) setup_agent_group_menu ;;
        4) manage_agent_users ;;
        5) manage_agent_services ;;
        6) run_original_flow ;;
        0) exit 0 ;;
        *) echo "❌ 无效选项，请重新选择。"; show_menu ;;
    esac
}

update_script() {
    log_info "开始更新配置脚本(GitHub)..."
    download_script "$SH_URL"
    make_executable
    log_info "✅ 配置脚本更新完成！"
    show_menu
}

update_script_cn() {
    log_info "开始更新配置脚本(国内源)..."
    download_script "$SH_CN_URL"
    make_executable
    log_info "✅ 配置脚本更新完成！"
    show_menu
}

setup_agent_group_menu() {
    log_info "开始设置 Agent 用户组..."
    create_agent_group
    ensure_agent_keys_directory
    log_info "✅ Agent 用户组、目录及历史文件权限修复完成！"
    show_menu
}

run_original_flow() {
    log_info "开始执行原始一键加固准备流程..."
    create_agent_group
    ensure_agent_keys_directory
    download_script "$SH_URL"
    make_executable
    log_info "✅ 一键加固准备流程完成！"
    show_menu
}

create_agent_group() {
    log_info "检查用户组: $AGENT_GROUP"
    if ! getent group "$AGENT_GROUP" > /dev/null; then
        if groupadd "$AGENT_GROUP"; then
            log_info "✅ 用户组 $AGENT_GROUP 创建成功"
        else
            log_error "❌ 创建用户组失败"; exit 1
        fi
    else
        log_info "!!!  用户组 $AGENT_GROUP 已存在"
    fi
}

# ✅ 修复历史遗留的 .pub 文件权限问题
ensure_agent_keys_directory() {
    log_info "检查并修复目录及文件权限: $AGENT_KEYS_DIR"
    
    if ! getent group "$AGENT_GROUP" > /dev/null; then
        log_error "❌ 依赖的用户组 $AGENT_GROUP 不存在"; exit 1
    fi

    # 1. 确保目录存在且权限正确
    [ ! -d "$AGENT_KEYS_DIR" ] && mkdir -p "$AGENT_KEYS_DIR"
    
    local dir_perms dir_owner
    dir_perms=$(stat -c "%a" "$AGENT_KEYS_DIR")
    dir_owner=$(stat -c "%U:%G" "$AGENT_KEYS_DIR")
    
    if [ "$dir_perms" != "750" ] || [ "$dir_owner" != "root:$AGENT_GROUP" ]; then
        chmod 750 "$AGENT_KEYS_DIR"
        chown root:"$AGENT_GROUP" "$AGENT_KEYS_DIR"
        log_info "🔧 已修正目录权限 -> 750 root:$AGENT_GROUP"
    else
        log_info "✅ 目录权限正确"
    fi

    # 2. 遍历修复目录下所有 .pub 文件权限 (解决 sshd Permission denied)
    local fixed_count=0
    if compgen -G "$AGENT_KEYS_DIR/*.pub" > /dev/null; then
        for pub_file in "$AGENT_KEYS_DIR"/*.pub; do
            local f_perms f_owner
            f_perms=$(stat -c "%a" "$pub_file")
            f_owner=$(stat -c "%U:%G" "$pub_file")
            
            if [ "$f_perms" != "640" ] || [ "$f_owner" != "root:$AGENT_GROUP" ]; then
                chown root:"$AGENT_GROUP" "$pub_file"
                chmod 640 "$pub_file"
                log_info "   🔧 修复文件: $(basename "$pub_file") -> 640 root:$AGENT_GROUP"
                ((fixed_count++))
            fi
        done
    fi

    if [ "$fixed_count" -eq 0 ]; then
        log_info "✅ 所有公钥文件权限均正确 (640)"
    else
        log_info "✅ 共修复了 $fixed_count 个错误的公钥文件权限"
    fi
}

download_script() {
    local url="$1"
    log_info "正在下载: $url"
    [ -f "$SCRIPT_NAME" ] && rm -f "$SCRIPT_NAME"
    
    if ! wget --tries=3 --timeout=30 "$url" -O "$SCRIPT_NAME"; then
        log_error "下载失败: $url"; exit 1
    fi
    log_info "✅ 下载成功"
}

make_executable() {
    chmod +x "$SCRIPT_NAME" && log_info "✅ 已赋予执行权限"
}

# --- 主入口 ---
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    show_menu
else
    create_agent_group
    ensure_agent_keys_directory
    download_script "$SH_URL"
    make_executable
fi