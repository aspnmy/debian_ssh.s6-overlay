#!/bin/bash
set -eo pipefail

DEVICE="rxe0"
DEFAULT_PORT=18515
RUN_DIR="/tmp/rdma"
mkdir -p "$RUN_DIR"

PID_FILE="$RUN_DIR/server.pid"
CLI_PID="$RUN_DIR/client.pid"
PORT_FILE="$RUN_DIR/port"
LOG_FILE="$RUN_DIR/rdma.log"
CLI_INFO="$RUN_DIR/cli.info"

# 清理异常信号
trap '' INT TERM HUP

# 功能函数
get_local_ip() { hostname -I | awk '{print $1}'; }
get_dns() { grep nameserver /etc/resolv.conf 2>/dev/null | awk '{print $2}' | head -3 | tr '
' ' '; }
get_port() { [ -f "$PORT_FILE" ] && cat "$PORT_FILE" || echo "未启动"; }
get_client() { [ -f "$CLI_INFO" ] && cat "$CLI_INFO" || echo "未连接"; }

is_running() {
  local pid="$1"
  [ -n "$pid" ] && ps -p "$pid" >/dev/null 2>&1 && echo "运行中" || echo "已停止"
}

kill_all() {
  pkill -f "ib_write_bw" 2>/dev/null || true
  pkill -f "nohup" 2>/dev/null || true
  pkill -f "tail" 2>/dev/null || true
}

clean_all() {
  kill_all
  rm -rf "$RUN_DIR"
  mkdir -p "$RUN_DIR"
}

set_dns() {
  cat > /etc/resolv.conf <<CONF
nameserver 8.8.8.8
nameserver 1.1.1.1
nameserver 8.8.4.4
CONF
}

show_log() {
  clear
  echo "============================================="
  echo "📋 实时日志（按 Ctrl+C 返回菜单）"
  echo "============================================="
  (
    trap exit INT
    tail -f "$LOG_FILE" 2>/dev/null
  )
  true
}

# 安全读取输入
safe_read() {
  local var
  read -r var
  echo "$var"
}

# 菜单
menu() {
  local s_pid=$(cat $PID_FILE 2>/dev/null)
  local c_pid=$(cat $CLI_PID 2>/dev/null)

  clear
  echo "============================================="
  echo "           🚀 RDMA 管理工具"
  echo "  容器IP: $(get_local_ip)"
  echo "  DNS    : $(get_dns)"
  echo "  服务端 : $(is_running $s_pid) | 端口: $(get_port)"
  echo "  客户端 : $(is_running $c_pid) | $(get_client)"
  echo "============================================="
  echo " 1 → 启动服务端  2 → 启动客户端  3 → 查看日志"
  echo " 4 → 设置公共DNS 5 → 停止全部    6 → 退出"
  echo "============================================="
  echo -n "请选择: "
}

# 主循环（永不卡死版）
while true; do
  menu
  CHOICE=$(safe_read)

  case "$CHOICE" in
    1)
      clean_all
      echo -e "\n启动服务端 (端口: $DEFAULT_PORT)..."
      echo "$DEFAULT_PORT" > "$PORT_FILE"
      nohup ib_write_bw -d "$DEVICE" -b -t 128 -p "$DEFAULT_PORT" > "$LOG_FILE" 2>&1 &
      echo $! > "$PID_FILE"
      echo -e "✅ 服务端已启动"
      sleep 1
      ;;

    2)
      echo
      echo -n "服务端IP: "
      IP=$(safe_read)
      echo -n "服务端端口: "
      PORT=$(safe_read)
      echo "连接: $IP:$PORT" > "$CLI_INFO"
      nohup ib_write_bw -d "$DEVICE" "$IP" -b -t 128 -p "$PORT" > "$LOG_FILE" 2>&1 &
      echo $! > "$CLI_PID"
      echo -e "✅ 客户端已启动"
      sleep 1
      ;;

    3)
      show_log
      ;;

    4)
      set_dns
      echo -e "✅ DNS 设置完成"
      sleep 1
      ;;

    5)
      clean_all
      echo -e "⏹️  已停止所有进程"
      sleep 1
      ;;

    6)
      echo -e "👋 退出"
      exit 0
      ;;

    *)
      # 不报错、不卡死
      ;;
  esac
done
