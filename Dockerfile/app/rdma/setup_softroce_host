#!/bin/bash
set -eo pipefail

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}"
echo "============================================="
echo " 🚀 宿主机 Soft-RoCE / RDMA 一键部署脚本 "
echo "============================================="
echo -e "${NC}"

# ==============================================
# 1. 安装依赖
# ==============================================
echo -e "${YELLOW}[1/5] 安装 RDMA 依赖...${NC}"
apt update >/dev/null 2>&1
apt install -y rdma-core iproute2 dmidecode >/dev/null 2>&1

# ==============================================
# 2. 加载内核模块
# ==============================================
echo -e "${YELLOW}[2/5] 加载 RDMA 内核模块...${NC}"
modprobe rdma_rxe 2>/dev/null || true
modprobe ib_uverbs 2>/dev/null || true
modprobe ib_core 2>/dev/null || true
modprobe udp_tunnel 2>/dev/null || true

# ==============================================
# 3. 开机自动加载模块
# ==============================================
echo -e "${YELLOW}[3/5] 设置开机自动加载模块...${NC}"
cat > /etc/modules-load.d/softroce.conf <<EOF
rdma_rxe
ib_uverbs
ib_core
udp_tunnel
EOF

# ==============================================
# 4. 获取真实网卡（自动找 eth0 / ens 开头）
# ==============================================
echo -e "${YELLOW}[4/5] 创建 rxe0 设备...${NC}"
NETDEV=$(ip route get 1.1.1.1 | awk '{print $5}' | head -n1)
rdma link del rxe0 2>/dev/null || true
rdma link add rxe0 type rxe netdev "${NETDEV}"

# ==============================================
# 5. 开机自启 rxe0（systemd 稳版本）
# ==============================================
echo -e "${YELLOW}[5/5] 设置开机自动创建 rxe0...${NC}"
cat > /etc/systemd/system/softroce.service <<EOF
[Unit]
Description=Soft-RoCE rxe0
After=network.target

[Service]
Type=oneshot
ExecStart=/sbin/rdma link add rxe0 type rxe netdev ${NETDEV}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable softroce.service

echo -e "${GREEN}"
echo "============================================="
echo " ✅ 宿主机 RDMA/Soft-RoCE 部署完成！"
echo "============================================="
echo -e "${NC}"

echo -e "${YELLOW}📊 运行状态：${NC}"
rdma link
lsmod | grep -E "rdma|ib_"

echo -e "${GREEN}"
echo "🎉 所有功能已启用！容器可直接使用 RDMA！"
echo "✅ 网卡：${NETDEV}"
echo -e "${NC}"