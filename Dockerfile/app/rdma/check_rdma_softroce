#!/bin/bash
set -eo pipefail

echo -e "\n============================================="
echo -e " 🚀 自动测试 Soft-RoCE + RDMA 功能 "
echo -e "=============================================\n"

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

success() {
    echo -e "${GREEN}[✅ SUCCESS]${NC} \$1"
}

error() {
    echo -e "${RED}[❌ FAILED]${NC} \$1"
    exit 1
}

# ------------------------------------------------------------------------------
# 1. 直接检查 /dev/infiniband （宿主机已经透传进来）
# ------------------------------------------------------------------------------
echo -e "\n[1/4] 检查 RDMA 设备节点..."
ls /dev/infiniband >/dev/null 2>&1 || error "未找到 RDMA 设备，请确认容器加了 --privileged"
success "RDMA 设备已透传"

# ------------------------------------------------------------------------------
# 2. 检查 ibv_devinfo 可用
# ------------------------------------------------------------------------------
echo -e "\n[2/4] 检查 RDMA 驱动..."
ibv_devinfo >/dev/null 2>&1 || error "ibv_devinfo 失败"
success "RDMA 驱动正常"

# ------------------------------------------------------------------------------
# 3. 检查是否有 rxe0 设备
# ------------------------------------------------------------------------------
echo -e "\n[3/4] 检查 Soft-RoCE 设备..."
rdma link >/dev/null 2>&1 || error "rdma 工具不可用"
rdma link | grep -q rxe0 || error "未找到 rxe0 设备"
success "Soft-RoCE 设备正常"

# ------------------------------------------------------------------------------
# 4. 测试 rping
# ------------------------------------------------------------------------------
echo -e "\n[4/4] 测试 RDMA 连接..."
rping -s >/dev/null 2>&1 &
SPID=\$!
sleep 1

if rping -c 127.0.0.1 -C 3 >/dev/null 2>&1; then
    kill \$SPID 2>/dev/null
    success "rping 测试成功"
else
    kill \$SPID 2>/dev/null
    error "rping 失败"
fi

echo -e "\n============================================="
success " 🎉 所有 RDMA + Soft-RoCE 测试全部通过！"
echo -e "=============================================\n"
