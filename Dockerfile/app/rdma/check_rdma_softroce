#!/bin/bash
set -eo pipefail

# 无颜色，避免乱码
RED=""
GREEN=""
NC=""

success() {
    echo "[✅ SUCCESS] $1"
}

error() {
    echo "[❌ FAILED] $1"
    exit 1
}

echo -e "\n============================================="
echo -e " 🚀 RDMA + Soft-RoCE 真实检测（无流量、真验证）"
echo -e "=============================================\n"

# 1. 检查设备文件
echo -e "\n[1/5] 检查 RDMA 设备节点..."
[ -d "/dev/infiniband" ] || error "未找到 RDMA 设备"
success "RDMA 设备已透传"

# 2. 检查驱动工具
echo -e "\n[2/5] 检查 RDMA 驱动状态..."
ibv_devinfo >/dev/null 2>&1 || error "RDMA 驱动异常"
success "RDMA 驱动正常加载"

# 3. 检查 Soft-RoCE 设备
echo -e "\n[3/5] 检查 Soft-RoCE (rxe) 设备..."
rdma link | grep -q "rxe" || error "未找到 Soft-RoCE 设备"
success "Soft-RoCE 设备存在"

# 4. 检查设备名称（真实验证）
echo -e "\n[4/5] 验证 RDMA 设备可枚举..."
ibv_devices | grep -E "rdma_rxe|rxe" >/dev/null 2>&1 || error "RDMA 设备不可用"
success "RDMA 设备可正常识别"

# 5. 真实验证：尝试打开 RDMA 设备（最核心真实测试）
echo -e "\n[5/5] 验证 RDMA 接口可正常使用..."
ibv_devinfo | grep -E "hca_id|port_phys_cnt|link_layer" >/dev/null 2>&1 || error "RDMA 接口异常"
success "RDMA 接口功能正常"

echo -e "\n============================================="
success " 🎉 真实验证全部通过！RDMA 可正常使用！"
echo -e "=============================================\n"
