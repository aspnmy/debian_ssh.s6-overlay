# 一致性构建镜像 buildah bud --no-cache -f dockerfiles -t 容器名
# 定义基础镜像标签构建参数，默认值用于本地测试
#ARG BASE_IMAGE_TAG=aspnmy/alpine-ssh:workbase_s6-overlay_stable2026010304

# 使用传入的基础镜像标签
FROM aspnmy/alpine-ssh:workbase_s6-overlay_stable2026010304
# # 复制root-sshkey管理工具
# /aspnmy/bin/setRootKey_Cli.sh 已经存在
# 使用git安装BestHostsMonitor
# 合并语句减小镜像体积
# Set DNS servers and hosts file for reliable git access
RUN echo "nameserver 8.8.8.8" > /etc/resolv.conf && \
    echo "nameserver 8.8.4.4" >> /etc/resolv.conf && \
    echo "140.82.113.4 github.com" >> /etc/hosts

# Install BestHostsMonitor using git
RUN apk add --no-progress --no-cache bash && \
    bash /aspnmy/bin/gitBestHostsMonitor.sh \
    && echo "bash +x /aspnmy/bin/BestHostsMonitor/bin/server/runtasks.sh" >> "/init"    \
    && rm -rf /tmp/* 

WORKDIR /aspnmy/bin
# 暴露622端口
EXPOSE 622

ENTRYPOINT ["/init"]
