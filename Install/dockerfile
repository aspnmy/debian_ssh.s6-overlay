# ==============================================================
# Dockerfile - s6-overlay v3 + SSH (命令合并优化)
# ==============================================================

# ========== 第一阶段：准备 s6-overlay ==========
FROM alpine:latest AS s6-preloader

ARG TARGETARCH

COPY s6-downloads/ /tmp/s6-downloads/

RUN echo "🔧 检测到架构: ${TARGETARCH:-amd64}" \
    && mkdir -p /tmp/s6-overlay \
    && case "${TARGETARCH}" in \
         amd64|"") \
           tar -C /tmp/s6-overlay -Jxpf /tmp/s6-downloads/s6-overlay-noarch.tar.xz && \
           tar -C /tmp/s6-overlay -Jxpf /tmp/s6-downloads/s6-overlay-x86_64.tar.xz ;; \
         arm64) \
           tar -C /tmp/s6-overlay -Jxpf /tmp/s6-downloads/s6-overlay-noarch.tar.xz && \
           tar -C /tmp/s6-overlay -Jxpf /tmp/s6-downloads/s6-overlay-aarch64.tar.xz ;; \
         *) echo "❌ 不支持的架构: ${TARGETARCH}"; exit 1 ;; \
       esac \
    && rm -rf /tmp/s6-downloads \
    && echo "✅ s6-overlay 解压完成"

# ========== 第二阶段：主应用 ==========
FROM debian:bookworm-slim

ARG TARGETARCH

# 复制 s6-overlay
COPY --from=s6-preloader /tmp/s6-overlay/ /

# 复制脚本
COPY ./setRootKey_Cli.sh.s6 /aspnmy/bin/

# ===== 🚀 合并所有 RUN 为一条（减少层数）=====
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
       ca-certificates \
       curl \
       openssh-server \
       openssh-client \
       tzdata \
       bash \
       sudo \
    && rm -rf /var/lib/apt/lists/* \
    \
    # chmod 脚本
    && chmod +x /aspnmy/bin/setRootKey_Cli.sh.s6 \
    \
    # 配置时区
    && rm -f /etc/localtime \
    && ln -s /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" | tee /etc/timezone \
    \
    # ⚠️ 以 root 权限执行 superman 模式
    && /aspnmy/bin/setRootKey_Cli.sh.s6 superman \
    \
    # 创建 s6-rc 服务目录结构（sshd + log）
    && mkdir -p /etc/s6-overlay/s6-rc.d/sshd/dependencies.d \
    && mkdir -p /etc/s6-overlay/s6-rc.d/sshd/log \
    && mkdir -p /etc/s6-overlay/s6-rc.d/user \
    && touch /etc/s6-overlay/s6-rc.d/user/contents.d/sshd \
    && touch /etc/s6-overlay/s6-rc.d/sshd/dependencies.d/base \
    && echo "longrun" > /etc/s6-overlay/s6-rc.d/sshd/type \
    && printf '#!/bin/sh\n/usr/sbin/sshd -D\n' > /etc/s6-overlay/s6-rc.d/sshd/run \
    && chmod +x /etc/s6-overlay/s6-rc.d/sshd/run \
    && printf '#!/bin/sh\nexec s6-log -b -- n20 s1000000 /var/log/sshd\n' > /etc/s6-overlay/s6-rc.d/sshd/log/run \
    && chmod +x /etc/s6-overlay/s6-rc.d/sshd/log/run \
    \
    # 配置 SSH（允许 root，端口 622）
    && mkdir -p /var/run/sshd \
    && sed -i 's/#Port 22/Port 622/' /etc/ssh/sshd_config \
    && sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && echo "root:root" | chpasswd

# 如果需要自定义 s6-rc.d 覆盖，可以保留这个 COPY
# COPY ./s6-rc.d/ /etc/s6-overlay/s6-rc.d/

EXPOSE 622
ENTRYPOINT ["/init"]